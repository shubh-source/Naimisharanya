<!DOCTYPE html>
<html lang="hi-IN" data-theme="divine">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - " : "")नैमिषारण्य तीर्थ धाम (Naimisharanya Dham)</title>
  <meta name="description" content="Official pilgrimage portal to Naimisharanya (Neemsar) Dham. Explore Chakra Tirtha, Maa Lalita Devi Shaktipeeth, Vyas Gaddi, daily aarti timings, and book authentic Pujas and Dharamshala stay." />
  <meta name="keywords" content="Naimisharanya, Neemsar, Chakra Tirtha, Lalita Devi Shaktipeeth, Vyas Gaddi, Hanuman Garhi, Sitapur, Puja Booking, Dharamshala" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="~/wp-content/uploads/2022/07/fav-1-1.png" />
  <link rel="apple-touch-icon" href="~/wp-content/uploads/2022/07/fav-1-1.png" />

  <!-- Stylesheets -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="~/assets/css/theme.css" />

  <!-- Schema.org JSON-LD Structured Data for Google -->
  <script type="application/ld+json">
  {
    "@@context": "https://schema.org",
    "@@graph": [
      {
        "@@type": "TouristAttraction",
        "@@id": "https://shubh-source.github.io/Naimisharanya/#attraction",
        "name": "Chakra Tirtha - Naimisharanya",
        "alternateName": "नैमिषारण्य चक्र तीर्थ",
        "description": "The sacred circular water kund created where Lord Brahma's manomaya chakra touched earth. Epicenter of spiritual purification and 84 Kosi Parikrama.",
        "url": "https://shubh-source.github.io/Naimisharanya/",
        "image": "https://shubh-source.github.io/Naimisharanya/wp-content/uploads/2022/07/slider1.jpg",
        "address": {
          "@@type": "PostalAddress",
          "addressLocality": "Naimisharanya",
          "addressRegion": "Uttar Pradesh",
          "postalCode": "261402",
          "addressCountry": "IN"
        },
        "telephone": "+91-9935010749"
      }
    ]
  }
  </script>
</head>
<body>

  <!-- Top Bar -->
  <div class="top-bar">
    <div class="container">
      <div class="top-bar-left">
        <span><i class="fa-solid fa-om" style="color:var(--gold);"></i> ॐ नमो भगवते वासुदेवाय</span>
        <span class="top-bar-marquee"><i class="fa-solid fa-bell"></i> 84 कोसी परिक्रमा एवं सोमवती अमावस्या पावन स्नान</span>
      </div>
      <div class="top-bar-right">
        <a href="tel:+919935010749"><i class="fa-solid fa-phone"></i> +91 9935010749</a>
        <a href="tel:+919935935573"><i class="fa-solid fa-phone"></i> +91 9935935573</a>
        <a href="https://wa.me/919935010749" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp" style="color:#25D366;"></i> WhatsApp</a>
        <a asp-controller="Home" asp-action="Admin" style="color:var(--gold); font-weight:700;"><i class="fa-solid fa-shield-halved"></i> Admin Portal</a>
      </div>
    </div>
  </div>

  <!-- Main Navigation & Theme Switcher -->
  <header class="main-header" role="banner">
    <div class="container nav-container">
      <a asp-controller="Home" asp-action="Index" class="brand-logo" aria-label="Naimisharanya Dham Home">
        <img src="~/wp-content/uploads/2022/07/LogoNamisarnya.jpg" alt="नैमिषारण्य तीर्थ Crest" width="52" height="52" />
        <div class="brand-text">
          <h1>नैमिषारण्य धाम</h1>
          <span>Naimisharanya Teerth Kshetra</span>
        </div>
      </a>

      <!-- Menu Links -->
      <nav aria-label="Main Navigation">
        <ul class="nav-menu" id="nav-menu">
          <li><a href="#hero" class="nav-link active">Home</a></li>
          <li><a href="#tirthas" class="nav-link">Sacred Sites</a></li>
          <li><a href="#aarti-schedule" class="nav-link">Aarti Timings</a></li>
          <li><a href="#booking" class="nav-link">Book Puja & Stay</a></li>
          <li><a href="#how-to-reach" class="nav-link">How to Reach</a></li>
          <li><a href="#gallery" class="nav-link">Darshan Gallery</a></li>
          <li><a href="#faq" class="nav-link">Pilgrim FAQ</a></li>
          <li><a href="#contact" class="nav-link">Contact</a></li>
        </ul>
      </nav>

      <!-- Theme Switcher & Actions -->
      <div class="nav-actions">
        <div class="theme-switcher-group" role="group" aria-label="Theme Selection">
          <button class="theme-btn active" data-theme-choice="divine" title="Divine Sacred Saffron Theme" aria-pressed="true">
            <i class="fa-solid fa-sun"></i> <span class="theme-text">Divine</span>
          </button>
          <button class="theme-btn" data-theme-choice="dark" title="Luxury Obsidian Dark Theme" aria-pressed="false">
            <i class="fa-solid fa-moon"></i> <span class="theme-text">Dark</span>
          </button>
          <button class="theme-btn" data-theme-choice="clean" title="Clean Ivory Modern Theme" aria-pressed="false">
            <i class="fa-solid fa-feather"></i> <span class="theme-text">Ivory</span>
          </button>
        </div>

        <a href="#booking" class="btn btn-primary" style="padding:0.55rem 1.15rem; font-size:0.88rem;">
          <i class="fa-solid fa-hands-praying"></i> Book Puja
        </a>

        <button class="mobile-nav-toggle" id="mobile-nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Page Body -->
  <main id="main-content">
    @RenderBody()
  </main>

  <!-- Site Footer -->
  <footer class="main-footer" role="contentinfo">
    <div class="container">
      <div class="footer-grid">
        <!-- Brand Summary -->
        <div class="footer-brand">
          <h3>नैमिषारण्य तीर्थ धाम</h3>
          <span>The Tapobhoomi of 88,000 Rishis</span>
          <p>
            The supreme spiritual epicenter where the divine wheel of Brahma rested, the 18 Maha Puranas were recorded by Maharishi Ved Vyas, and Maa Lalita Devi showers eternal grace.
          </p>
          <div style="margin-top:1.25rem;">
            <a asp-controller="Home" asp-action="Admin" style="color:var(--gold); font-size:0.9rem; font-weight:700;">
              <i class="fa-solid fa-lock"></i> Temple Sewak Admin Portal
            </a>
          </div>
        </div>

        <!-- Sacred Shrines Links -->
        <div class="footer-links-col">
          <h4>Sacred Shrines</h4>
          <ul class="footer-links">
            <li><a href="#tirthas">Chakra Tirtha</a></li>
            <li><a href="#tirthas">Maa Lalita Devi Mandir</a></li>
            <li><a href="#tirthas">Maharishi Vyas Gaddi</a></li>
            <li><a href="#tirthas">Hanuman Garhi Balaji</a></li>
            <li><a href="#tirthas">Soot Gaddi</a></li>
            <li><a href="#tirthas">Dadhichi Kund (Mishrikh)</a></li>
          </ul>
        </div>

        <!-- Pilgrim Services -->
        <div class="footer-links-col">
          <h4>Devotee Services</h4>
          <ul class="footer-links">
            <li><a href="#booking">Book Puja & Sankalpa</a></li>
            <li><a href="#booking">Dharamshala Booking</a></li>
            <li><a href="#aarti-schedule">Aarti Timings</a></li>
            <li><a href="#how-to-reach">How to Reach</a></li>
            <li><a href="#gallery">Virtual Darshan</a></li>
            <li><a href="#faq">Pilgrim FAQ</a></li>
          </ul>
        </div>

        <!-- Newsletter & Helpline -->
        <div class="footer-links-col">
          <h4>Devotee Newsletter</h4>
          <p style="font-size:0.88rem; color:var(--footer-muted); margin-bottom:1rem;">
            Subscribe to receive holy Amavasya, Purnima and Navratri festival announcements.
          </p>
          <form id="newsletter-form" style="display:flex; gap:0.5rem; margin-bottom:1.5rem;">
            <input type="email" name="email-1" placeholder="Your Email Address" required style="padding:0.65rem 0.85rem; border-radius:6px; border:1px solid rgba(255,255,255,0.2); background:rgba(255,255,255,0.06); color:#fff; font-size:0.88rem; outline:none; width:100%;" />
            <button type="submit" class="btn btn-gold" style="padding:0.65rem 1rem; font-size:0.88rem;">Join</button>
          </form>

          <ul class="footer-contact-list">
            <li>
              <i class="fa-solid fa-phone"></i>
              <a href="tel:+919935010749">+91 9935010749 / +91 9935935573</a>
            </li>
            <li>
              <i class="fa-solid fa-envelope"></i>
              <span>contact@naimisharanya.org</span>
            </li>
            <li>
              <i class="fa-solid fa-location-dot"></i>
              <span>Naimisharanya, Sitapur, UP 261402</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <div>
          © 2026 नैमिषारण्य तीर्थ धाम (Naimisharanya Dham). All rights reserved. Consecrated for Dharma & Devotees.
        </div>
        <div style="display:flex; gap:1.25rem;">
          <a href="#hero">Back to Top <i class="fa-solid fa-arrow-up"></i></a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Booking Confirmation Modal -->
  <div class="modal-overlay" id="booking-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-container">
      <button class="modal-close-btn" id="modal-close-btn" aria-label="Close booking confirmation modal">&times;</button>
      <div class="modal-icon"><i class="fa-solid fa-om"></i></div>
      <h3 class="modal-title" id="modal-title">दर्शन एवं पूजा संकल्प दर्ज</h3>
      <p style="color:var(--text-muted); font-size:0.95rem;">
        Your Puja / Darshan booking inquiry has been recorded successfully.
      </p>
      <div>
        <span style="font-size:0.8rem; text-transform:uppercase; color:var(--text-light); font-weight:700;">Booking Reference Code:</span><br />
        <span class="modal-token" id="modal-booking-ref">ND-2026-XXXX</span>
      </div>
      <p id="modal-booking-summary" style="font-size:0.92rem; color:var(--text-main); margin-top:0.5rem;"></p>
      <div style="background:var(--bg-alt); padding:0.85rem; border-radius:8px; font-size:0.85rem; color:var(--text-muted); margin-bottom:1.5rem;">
        Our verified Teerth Purohit will contact you on WhatsApp / Phone within 2 hours to confirm your rituals and muhurta.
      </div>
      <button type="button" class="btn btn-primary" onclick="document.getElementById('booking-modal').classList.remove('open'); document.body.style.overflow='';" style="width:100%;">
        जय नैमिषारण्य धाम (Done)
      </button>
    </div>
  </div>

  <!-- Gallery Lightbox Preview -->
  <div class="lightbox-overlay" id="gallery-lightbox" role="dialog" aria-modal="true">
    <div class="lightbox-content">
      <button class="lightbox-close" id="lightbox-close" aria-label="Close image preview">&times;</button>
      <img id="lightbox-img" src="" alt="Enlarged photo preview" />
      <div class="lightbox-caption" id="lightbox-caption"></div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="~/assets/js/main.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
