              <i class="fa-solid fa-circle-check"></i>
              <div>
                <strong>Authorized Vedic Pandits:</strong> Authentic Sankalpa, Rudrabhishek, Chandi Paath, and Pitru Tarpan.
              </div>
            </li>
            <li>
              <i class="fa-solid fa-circle-check"></i>
              <div>
                <strong>Pravas (Stay) Assistance:</strong> Clean AC/Non-AC dharamshalas and ashram guest rooms near Chakra Tirtha.
              </div>
            </li>
            <li>
              <i class="fa-solid fa-circle-check"></i>
              <div>
                <strong>84 Kosi Parikrama Guide:</strong> Dedicated guides for elderly pilgrims and family groups.
              </div>
            </li>
            <li>
              <i class="fa-solid fa-circle-check"></i>
              <div>
                <strong>Zero Middlemen / Transparent Seva:</strong> Direct connection to hereditary temple sewaks.
              </div>
            </li>
          </ul>
        </div>

        <div class="booking-helpline-box">
          <p>Immediate Devotee Assistance</p>
          <a href="tel:+919935010749"><i class="fa-solid fa-phone-volume"></i> +91 9935010749</a>
          <div style="font-size:0.85rem; color:#CBD5E1; margin-top:0.35rem;">
            Available 24x7 for urgent darshan and booking inquiries.
          </div>
        </div>
      </div>

      <!-- Right Booking Form Pane -->
      <div class="booking-form-pane">
        <form id="puja-booking-form">
          <div class="booking-form-grid">
            <!-- Service Selection -->
            <div class="form-group full-width">
              <label for="booking-service" class="form-label">
                <i class="fa-solid fa-om" style="color:var(--gold);"></i> Select Puja / Seva Required *
              </label>
              <select id="booking-service" name="service" class="form-select" required>
                <option value="Maa Lalita Devi Chandi Paath & Shringar">माँ ललिता देवी चंडी पाठ एवं विशेष शृंगार (Chandi Paath & Shringar)</option>
                <option value="Rudrabhishek & Mahamrityunjay Japa">रुद्राभिषेक एवं महामृत्युंजय जप (Rudrabhishek & Shiva Puja)</option>
                <option value="Chakra Snan Sankalpa & Pitru Tarpan">चक्र तीर्थ स्नान संकल्प एवं पितृ तर्पण / पिण्ड दान (Pitru Tarpan & Snan)</option>
                <option value="Vyas Gaddi Puranik Archana">व्यास गद्दी पौराणिक अर्चना एवं श्रीमद्भागवत संकल्प</option>
                <option value="Dharamshala / AC Pravas Room Booking">धर्मशाला / एसी अतिथि कक्ष प्रवास बुकिंग (Pravas Stay)</option>
                <option value="84 Kosi Parikrama Official Guide">84 कोसी परिक्रमा अधिकृत तीर्थ पुरोहित / मार्गदर्शक</option>
                <option value="General VIP Darshan Facilitation">विशेष दर्शन व्यवस्था (VIP Darshan Facilitation)</option>
              </select>
            </div>

            <!-- Devotee Full Name -->
            <div class="form-group">
              <label for="booking-name" class="form-label">
                <i class="fa-solid fa-user"></i> Devotee Name (नाम) *
              </label>
              <input type="text" id="booking-name" name="name" class="form-control" placeholder="उदा. पं. रमेश शर्मा" required />
            </div>

            <!-- Mobile / WhatsApp -->
            <div class="form-group">
              <label for="booking-phone" class="form-label">
                <i class="fa-solid fa-mobile-screen-button"></i> Mobile / WhatsApp *
              </label>
              <input type="tel" id="booking-phone" name="phone" class="form-control" placeholder="+91 98765 43210" required />
            </div>

            <!-- Email Address -->
            <div class="form-group">
              <label for="booking-email" class="form-label">
                <i class="fa-regular fa-envelope"></i> Email Address (ईमेल)
              </label>
              <input type="email" id="booking-email" name="email" class="form-control" placeholder="yourname@gmail.com" />
            </div>

            <!-- Date of Visit -->
            <div class="form-group">
              <label for="booking-date" class="form-label">
                <i class="fa-regular fa-calendar"></i> Date of Visit (आगमन तिथि) *
              </label>
              <input type="date" id="booking-date" name="date" class="form-control" required />
            </div>

            <!-- Pilgrims Count -->
            <div class="form-group">
              <label for="booking-pilgrims" class="form-label">
                <i class="fa-solid fa-user-group"></i> Total Pilgrims (तीर्थयात्री) *
              </label>
              <select id="booking-pilgrims" name="pilgrims" class="form-select" required>
                <option value="1">1 Person (एक व्यक्ति)</option>
                <option value="2">2 Persons (दो व्यक्ति)</option>
                <option value="3-5" selected>3 to 5 (परिवार / Family)</option>
                <option value="6-10">6 to 10 (ग्रुप / Group)</option>
                <option value="11+">More than 10 (बड़ा जत्था)</option>
              </select>
            </div>

            <!-- Gotra / Special Rituals Note -->
            <div class="form-group full-width">
              <label for="booking-message" class="form-label">
