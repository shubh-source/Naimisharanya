<section class="section-padding" id="faq" aria-labelledby="faq-heading">
  <div class="container">
    <div class="text-center">
      <span class="section-badge"><i class="fa-solid fa-circle-question"></i> महत्वपूर्ण जिज्ञासाएं</span>
      <h2 class="section-title" id="faq-heading">तीर्थयात्री <span>मार्गदर्शन एवं प्रश्नोत्तरी</span></h2>
      <p class="section-subtitle">
        नैमिषारण्य तीर्थ यात्रा, चक्रतीर्थ स्नान, पूजा संकल्प एवं प्रवास से जुड़े मुख्य प्रश्न
      </p>
    </div>

    <div class="faq-grid">
      <div>
        <div class="guideline-box">
          <h4><i class="fa-solid fa-water" style="color:var(--gold);"></i> चक्रतीर्थ स्नान नियम</h4>
          <p>
            पवित्र मन से स्नान करें। घाटों पर बने पक्के सोपानों का प्रयोग करें। स्नान के समय गायत्री मंत्र, महामृत्युंजय मंत्र अथवा वासुदेव द्वादशाक्षर मंत्र का जप अनंत गुना पुण्य प्रदान करता है।
          </p>
        </div>

        <div class="guideline-box">
          <h4><i class="fa-solid fa-shirt" style="color:var(--gold);"></i> मंदिर वस्त्र आचार संहिता</h4>
          <p>
            पारंपरिक भारतीय परिधान सर्वोत्तम हैं। पुरुषों हेतु धोती-कुर्ता अथवा पायजामा-कुर्ता तथा महिलाओं हेतु साड़ी अथवा सलवार-सूट उपयुक्त हैं। गर्भगृह में चमड़े की वस्तुएं ले जाना वर्जित है।
          </p>
        </div>

        <div class="guideline-box">
          <h4><i class="fa-solid fa-calendar-days" style="color:var(--gold);"></i> यात्रा का सर्वोत्तम समय</h4>
          <p>
            <strong>अक्टूबर से मार्च</strong> का मौसम अत्यंत सुखद रहता है। विशेष धार्मिक अवसरों में <strong>सोमवती अमावस्या</strong>, <strong>चैत्र व शारदीय नवरात्र</strong> एवं <strong>फाल्गुन मास की 84 कोसी परिक्रमा</strong> प्रमुख हैं।
          </p>
        </div>
      </div>

      <div>
        <div class="faq-item active">
          <button class="faq-question" type="button">
            <span>1. श्री सत्यनारायण व्रत कथा का नैमिष से क्या संबंध है?</span>
            <i class="fa-solid fa-chevron-down"></i>
          </button>
          <div class="faq-answer">
            स्कंद पुराण के रेवा खंड के अनुसार, श्री सत्यनारायण व्रत कथा का प्रादुर्भाव इसी नैमिषारण्य तीर्थ से हुआ था, जहाँ महर्षि सूत जी ने शौनकादि 88,000 ऋषियों के कल्याण हेतु इस कथा का प्रथम वाचन किया था।
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" type="button">
            <span>2. नैमिषारण्य को "नाभि गया" क्यों कहा जाता है? गया क्षेत्र का क्या महात्म्य है?</span>
            <i class="fa-solid fa-chevron-down"></i>
          </button>
          <div class="faq-answer">
            सनातन परंपरा एवं पुराणों के अनुसार तीन परम पावन गया क्षेत्र मान्य हैं—<strong>चरण गया (गया जी, बिहार)</strong>, <strong>कपाल गया (बद्रीनाथ, उत्तराखंड)</strong> व <strong>नाभि गया (नैमिषारण्य, उत्तर प्रदेश)</strong>। नैमिषारण्य तीर्थ को साक्षात नाभि गया माना जाता है। यहाँ चक्रतीर्थ व पावन गोमती संगम पर पितरों के निमित्त किया गया श्राद्ध, पिंडदान, तर्पण एवं त्रिपिंडी कर्म उन्हें जन्म-मरण के बंधन से मुक्त कर सीधे मोक्ष व वैकुंठ धाम प्रदान करता है।
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" type="button">
            <span>3. काशी विश्वनाथ मंदिर का नैमिष में क्या महात्म्य है?</span>
            <i class="fa-solid fa-chevron-down"></i>
          </button>
          <div class="faq-answer">
            महर्षि दधीचि के अस्थि दान संकल्प पर इंद्र के आमंत्रण पर साक्षात बाबा काशी विश्वनाथ जी यहाँ पधारे थे। यह मंदिर तीर्थवासियों के कुलदेवता के रूप में पूजा जाता है और यहाँ पूजन से बनारस के काशी विश्वनाथ के बराबर पुण्य प्राप्त होता है।
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" type="button">
            <span>4. क्या नैमिष टूरिस्ट सर्विसेज द्वारा होटल व वाहन उपलब्ध कराए जाते हैं?</span>
            <i class="fa-solid fa-chevron-down"></i>
          </button>
          <div class="faq-answer">
            हाँ, वर्ष 2005 से स्थापित नैमिष टूरिस्ट सर्विसेज द्वारा एसी/नॉन-एसी कमरे, हॉल, सेडान, इनोवा, टेम्पो ट्रेवलर एवं बसें, सात्विक भोजन और बहुभाषी (हिंदी, अंग्रेजी, तेलगु, गुजराती) गाइड सेवा उचित दरों पर उपलब्ध कराई जाती है।
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" type="button">
            <span>5. हत्या हरण तीर्थ में क्या विशेषता है?</span>
            <i class="fa-solid fa-chevron-down"></i>
          </button>
          <div class="faq-answer">
            यहाँ स्नान करने से ब्रह्म हत्या एवं जीव हत्या जैसे घोर पापों का शमन होता है। लंका विजय के बाद मर्यादा पुरुषोत्तम भगवान श्री राम ने इसी तीर्थ में स्नान कर ब्रह्म हत्या के दोष से मुक्ति पाई थी।
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

