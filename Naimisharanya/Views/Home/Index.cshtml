	<script type="text/javascript">
		var welcomeText = "हमारे नैमिषारण्य धाम में आपका स्वागत है|";
		var taglineText = "\"नैमिषारण्य धाम – जहां ज्ञान, भक्ति और मोक्ष का संगम होता है।\"";
		var speed = 40;
		var initialDelay = 600;
		function typeWriter(text, elementId, index) {
			var el = document.getElementById(elementId);
			if (!el) return;
			if (index < text.length) {
				el.innerHTML += text.charAt(index);
				setTimeout(function () {
					typeWriter(text, elementId, index + 1);
				}, speed);
			}
		}
		function initTypewriter() {
			var wEl = document.getElementById("welcomeText");
			var tEl = document.getElementById("taglineText");
			if (wEl) wEl.innerHTML = "";
			if (tEl) tEl.innerHTML = "";
			setTimeout(function () {
				typeWriter(welcomeText, "welcomeText", 0);
				setTimeout(function () {
					typeWriter(taglineText, "taglineText", 0);
				}, welcomeText.length * speed + 300);
			}, initialDelay);
		}
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initTypewriter);
		} else {
			initTypewriter();
		}
	</script>
