@{
    ViewData["Title"] = "नैमिषारण्य तपोभूमि - वेद, शास्त्र, पुराणों की आधारभूमि";
}

<!-- ==========================================================================
     HERO SECTION - DIVINE PILGRIMAGE DESTINATION
     ========================================================================== -->
<section class="hero-section" id="hero" aria-label="Hero Introduction">
  <!-- Full Background Image Slideshow (smallsizephotoes) -->
  <div class="hero-bg-slider" id="hero-slider" aria-hidden="true">
    <div class="hero-slide active" style="background-image: url('@Url.Content("~/assets/images/hero-01.jpg")');"></div>
    <div class="hero-slide" style="background-image: url('@Url.Content("~/assets/images/hero-02.jpg")');"></div>
    <div class="hero-slide" style="background-image: url('@Url.Content("~/assets/images/hero-03.jpg")');"></div>
    <div class="hero-slide" style="background-image: url('@Url.Content("~/assets/images/hero-04.jpg")');"></div>
  </div>
  <div class="hero-overlay"></div>

  <!-- Foreground Clean Content -->
  <div class="container hero-content">
    <!-- Sacred Badge -->
    <div class="hero-sacred-badge">
      <i class="fa-solid fa-om"></i>
      <span>सतयुग का प्रधान तीर्थ</span>
    </div>

    <!-- Grand Main Heading -->
    <h1 class="hero-title">
      नैमिषारण्य तपोभूमि
      <span class="hero-subtitle">वेद, शास्त्र एवं पुराणों की आधारभूमि</span>
    </h1>

    <!-- Sacred Inscription Plaque (Shloka from Devi Bhagavata Purana) -->
    <div class="hero-shloka-card">
      <div class="shloka-content">
        <i class="fa-solid fa-quote-left shloka-quote-icon"></i>
        <p class="shloka-verse">“प्रथमं नैमिषं पुण्यं, चक्रतीर्थं च पुष्करम्। अन्येषां चैव तीर्थानां संख्या नास्ति महीतले॥”</p>
      </div>
      <div class="shloka-meta">
        <span class="shloka-scripture"><i class="fa-solid fa-scroll"></i> देवी भागवत पुराण</span>
      </div>
    </div>

    <!-- Short Crisp Line -->
    <p class="hero-desc">
      88,000 ऋषियों की पावन ज्ञानभूमि • चक्रतीर्थ एवं मां ललिता देवी शक्तिपीठ 108 धाम
    </p>

    <!-- Streamlined Action CTAs -->
    <div class="hero-actions">
      <a href="#booking" class="btn btn-hero-gold">
        <i class="fa-solid fa-hands-praying"></i> दर्शन / अनुष्ठान बुक करें
      </a>
      <a href="#tirthas" class="btn btn-hero-glass">
        <i class="fa-solid fa-gopuram"></i> प्रमुख दर्शनीय स्थल देखें
      </a>
    </div>

    <!-- 4 Sacred Shrine Photo Cards Dock -->
    <div class="hero-shrine-dock">
      <div class="hero-dock-header">
        <i class="fa-solid fa-location-dot" style="color:var(--gold);"></i>
        <span>प्रमुख दर्शन स्थल (क्लिक करके फोटो बदलें):</span>
      </div>
      <div class="hero-shrine-cards" role="tablist" aria-label="प्रमुख दर्शन स्थल">
        <button class="hero-shrine-btn active" data-slide-index="0" aria-label="भूतेश्वर नाथ महादेव">
          <div class="hero-shrine-thumb">
            <img src="~/assets/images/hero-01.jpg" alt="भूतेश्वर नाथ" loading="eager" />
          </div>
          <div class="hero-shrine-meta">
            <span class="hero-shrine-name">भूतेश्वर नाथ</span>
            <span class="hero-shrine-tag">स्वयंभू शिवलिंग</span>
          </div>
        </button>

        <button class="hero-shrine-btn" data-slide-index="1" aria-label="श्री हनुमान गढ़ी">
          <div class="hero-shrine-thumb">
            <img src="~/assets/images/hero-02.jpg" alt="हनुमान गढ़ी" loading="eager" />
          </div>
          <div class="hero-shrine-meta">
            <span class="hero-shrine-name">हनुमान गढ़ी</span>
            <span class="hero-shrine-tag">अहिरावण दर्शन</span>
          </div>
        </button>

        <button class="hero-shrine-btn" data-slide-index="2" aria-label="मनु शतरूपा तपस्थान">
          <div class="hero-shrine-thumb">
            <img src="~/assets/images/hero-03.jpg" alt="मनु शतरूपा" loading="eager" />
          </div>
          <div class="hero-shrine-meta">
            <span class="hero-shrine-name">मनु शतरूपा</span>
            <span class="hero-shrine-tag">23,000 वर्ष तपस्थली</span>
          </div>
        </button>

        <button class="hero-shrine-btn" data-slide-index="3" aria-label="व्यास गद्दी">
          <div class="hero-shrine-thumb">
            <img src="~/assets/images/hero-04.jpg" alt="व्यास गद्दी" loading="eager" />
          </div>
          <div class="hero-shrine-meta">
            <span class="hero-shrine-name">व्यास गद्दी</span>
            <span class="hero-shrine-tag">18 पुराण रचना स्थली</span>
          </div>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- ==========================================================================
     CONTENT 1: "नैमिषारण्य तपोभूमि" (वेद, शास्त्र, पुराणों की आधारभूमि) & नामकरण
     ========================================================================== -->
<section class="section-padding" id="history" style="background:var(--bg-alt);" aria-labelledby="history-heading">
  <div class="container">
    <div class="text-center">
      <span class="section-badge"><i class="fa-solid fa-book-quran"></i> पौराणिक महात्म्य</span>
      <h2 class="section-title" id="history-heading">नैमिषारण्य <span>तपोभूमि का आध्यात्मिक गौरव</span></h2>
      <p class="section-subtitle">
        वेद, शास्त्र, पुराणों की आधारभूमि — सतयुग के प्रधान तीर्थ का दिव्य इतिहास एवं पौराणिक प्रमाण
      </p>
    </div>

    <div class="history-showcase">
      <div class="history-grid">
        <div>
          <h3 style="font-size:1.85rem; margin-bottom:1rem; color:var(--text-main); font-family:var(--font-serif);">
            <i class="fa-solid fa-dharmachakra" style="color:var(--gold);"></i> सतयुग का प्रधान तीर्थ — तीरथवर
          </h3>
          <p style="font-size:1.05rem; line-height:1.8; color:var(--text-main);">
            नैमिषारण्य तीर्थ युग परंपरा के अनुसार <strong>सतयुग के प्रधान तीर्थ</strong> के रूप में जाना जाता है। इस पावन तीर्थ का वर्णन समस्त <strong>18 पुराणों</strong> में प्राप्त होता है। अखिल विश्व में कल्याणकारी <strong>श्री सत्यनारायण व्रत कथा</strong> का प्रारंभ इसी नैमिषारण्य की पावन भूमि से ही हुआ था, जिसका प्रत्यक्ष वर्णन <em>स्कंद पुराण के रेवा खंड</em> में प्राप्त होता है।
          </p>

          <div class="history-quote-box">
            <div style="margin-bottom:0.75rem; padding-bottom:0.65rem; border-bottom:1px solid rgba(245, 158, 11, 0.35);">
              <p style="font-family:var(--font-hindi); font-size:1.15rem; color:var(--primary); font-weight:700; line-height:1.6; margin-bottom:0.35rem;">
                “प्रथमं नैमिषं पुण्यं, चक्रतीर्थं च पुष्करम्।<br>अन्येषां चैव तीर्थानां संख्या नास्ति महीतले॥”
              </p>
              <span style="font-size:0.85rem; color:var(--gold); font-weight:700;"><i class="fa-solid fa-scroll"></i> — देवी भागवत पुराण</span>
            </div>
            <p>
              “महर्षि तुलसीदास जी ने रामचरितमानस में नैमिषारण्य तीर्थ को <strong>‘तीरथवर’</strong> के नाम से संबोधित किया है। इसी भूमि पर सृष्टि के प्रथम पुरुष और स्त्री <strong>राजा मनु एवं रानी शतरूपा ने 23,000 वर्ष तपस्या</strong> करके इसी भूमि के आशीर्वाद से अगले जन्म में राजा दशरथ व रानी कौशल्या बनकर भगवान को पुत्र रूप में प्राप्त किया था।”
            </p>
          </div>

          <p style="font-size:1.02rem; line-height:1.75; color:var(--text-muted);">
            वही इस पुनीत तीर्थ पर पितृकार्यों का विशेष फल प्राप्त होता है। सनातन गया क्षेत्र में <strong>चरण गया (गया जी, बिहार)</strong>, <strong>कपाल गया (बद्रीनाथ, उत्तराखंड)</strong> एवं <strong>नाभि गया (नैमिषारण्य, उत्तर प्रदेश)</strong> की त्रिवेणी मान्यता है। नैमिषारण्य को पावन ‘नाभि गया’ क्षेत्र के रूप में पूजा जाता है। ऐसी दृढ़ मान्यता है कि नैमिषारण्य तीर्थ की <strong>चौरासी (84) कोस की परिधि में सभी 33 कोटि देव और साढ़े तीन करोड़ तीर्थों का वास</strong> है।
          </p>
        </div>

        <div>
          <div class="legend-callout" style="background:var(--bg-surface); padding:2rem; box-shadow:var(--shadow-md);">
            <h4><i class="fa-solid fa-circle-question"></i> क्यों पड़ा नैमिषारण्य नाम?</h4>
            <p style="font-size:0.95rem; line-height:1.7; color:var(--text-muted); margin-bottom:1rem;">
              <strong>श्रीमद्भागवत पुराण, शिवपुराण, एवं कूर्मपुराण</strong> के अनुसार मान्यता है कि एक बार सभी ऋषि-मुनियों एवं देवताओं ने भगवान ब्रह्मा जी के पास जाकर पृथ्वी की सर्वश्रेष्ठ तपोभूमि के बारे में प्रश्न किया।
            </p>
            <p style="font-size:0.95rem; line-height:1.7; color:var(--text-muted); margin-bottom:1rem;">
              सभी के निवेदन को स्वीकार करते हुए ब्रह्मा जी ने अपने हृदय से एक दिव्य चक्र उत्पन्न किया, जिसको <strong>‘ब्रह्ममनोमय चक्र’</strong> के नाम से जाना गया। ब्रह्मा जी ने आदेश दिया कि यह चक्र वायु मार्ग से पृथ्वी का भ्रमण करेगा और जहाँ कहीं भी यह चक्र भूमि को स्पर्श करेगा, वह भूमि तपस्या के लिए सर्वोत्तम होगी।
            </p>
            <div style="background:var(--bg-alt); padding:1rem; border-radius:8px; border-left:3px solid var(--gold); font-size:0.92rem; color:var(--text-main);">
              <strong>नैमि + अरण्य = नैमिषारण्य:</strong> इसमें ‘नैमि’ से तात्पर्य चक्र की धुरी से है, जबकि ‘अरण्य’ की मान्यता दिव्य वन के रूप में है। वहीं विष्णु पुराण में सुदर्शन चक्र तथा भगवान विष्णु द्वारा निमिष मात्र समय में दुर्जय राक्षस के वध के कारण भी इस पावन भूमि को नैमिषारण्य कहा जाता है।
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ==========================================================================
     CONTENT 2: प्रमुख दर्शनीय स्थल (All 19 Sacred Landmark Sites)
     ========================================================================== -->
<section class="section-padding" id="tirthas" aria-labelledby="tirthas-heading">
  <div class="container">
    <div class="text-center">
      <span class="section-badge"><i class="fa-solid fa-temple"></i> पौराणिक तीर्थ दर्शन</span>
      <h2 class="section-title" id="tirthas-heading">प्रमुख <span>दर्शनीय स्थल</span></h2>
      <p class="section-subtitle">
        नैमिषारण्य तपोभूमि के समस्त 19 अति पावन एवं सिद्ध मंदिरों, तीर्थों व तपस्थलों का संपूर्ण परिचय
      </p>
    </div>

    <div class="tirthas-grid">
      <!-- 1. चक्रतीर्थ -->
      <article class="tirtha-card">
        <div class="tirtha-img-wrap">
          <span class="tirtha-tag">अधिष्ठात्र देव</span>
          <img src="~/wp-content/uploads/2022/07/slider1.jpg" alt="चक्रतीर्थ कुंड" loading="lazy" />
        </div>
        <div class="tirtha-content">
          <span class="tirtha-hindi-name">1. चक्रतीर्थ (Chakra Tirtha)</span>
          <h3 class="tirtha-title">ब्रह्ममनोमय चक्र का उद्गम स्थल</h3>
          <p class="tirtha-desc">
            यह नैमिषारण्य तीर्थ के अधिष्ठात्र देव हैं। यहीं पर ब्रह्मा जी का ब्रह्ममनोमय चक्र पृथ्वी पर प्राप्त हुआ था। वहीं भगवान विष्णु द्वारा निमिष मात्र समय में दुर्जय नाम के राक्षस का वध किए जाने के कारण निमिष और अरण्य के रूप में नैमिषारण्य तीर्थ की सर्वोच्च मान्यता है।
          </p>
          <div class="tirtha-meta">
            <span><i class="fa-solid fa-water"></i> पावन स्नान एवं तर्पण</span>
            <span><i class="fa-solid fa-location-dot"></i> केंद्र स्थल</span>
          </div>
        </div>
      </article>

      <!-- 2. मां ललिता देवी शक्तिपीठ 108 -->
      <article class="tirtha-card">
        <div class="tirtha-img-wrap">
          <span class="tirtha-tag">108 शक्तिपीठ</span>
          <img src="~/assets/images/shrine-lalita-devi.jpg" alt="मां ललिता देवी शक्तिपीठ 108" class="shrine-center" loading="lazy" />
        </div>
        <div class="tirtha-content">
          <span class="tirtha-hindi-name">2. मां ललिता देवी शक्तिपीठ 108</span>
          <h3 class="tirtha-title">लिंगधारिणी मां ललिता देवी</h3>
          <p class="tirtha-desc">
            मां ललिता देवी शक्तिपीठ 108 आदिशक्ति के पवित्र 108 शक्तिपीठों में से एक है। यहाँ आदि शक्ति लिंगधारिणी माँ ललिता देवी के रूप में प्रतिष्ठित हैं। यहाँ अखंड ज्योति के दर्शन व चंडी पाठ से मनोवांछित फल प्राप्त होते हैं। सामान्य दिवस में मंदिर कपाट दोपहर 12 से 12:30 बजे तक बंद रहते हैं।
          </p>
          <div class="tirtha-meta">
            <span><i class="fa-solid fa-clock"></i> कपाट बंद: दोपहर 12 से 12:30 (सामान्य दिवस)</span>
            <span><i class="fa-solid fa-fire"></i> अखंड ज्योति</span>
            <span><i class="fa-solid fa-certificate"></i> सिद्ध 108 शक्तिपीठ</span>
          </div>
        </div>
      </article>

      <!-- 3. भूतेश्वर नाथ महादेव -->
      <article class="tirtha-card">
        <div class="tirtha-img-wrap">
          <span class="tirtha-tag">तीर्थ के कोतवाल</span>
          <img src="~/assets/images/shrine-bhuteshwar.jpg" alt="भूतेश्वर नाथ महादेव" class="shrine-midupper" loading="lazy" />
        </div>
        <div class="tirtha-content">
          <span class="tirtha-hindi-name">3. भूतेश्वर नाथ महादेव</span>
          <h3 class="tirtha-title">तीनों पहर में अलग-अलग दिव्य स्वरूप</h3>
          <p class="tirtha-desc">
            यह प्राचीन मंदिर चक्रतीर्थ प्रांगण पर ही स्थित है। भगवान भूतेश्वर नाथ नैमिषारण्य तीर्थ के कोतवाल (रक्षक) कहे जाते हैं। दिन के तीनों पहर (सुबह, दोपहर, संध्या) में भगवान भूतेश्वर नाथ के अलग-अलग अलौकिक स्वरूप के दर्शन प्राप्त होते हैं।
          </p>
          <div class="tirtha-meta">
            <span><i class="fa-solid fa-shield-halved"></i> रक्षक कोतवाल</span>
            <span><i class="fa-solid fa-om"></i> चक्रतीर्थ प्रांगण</span>
          </div>
        </div>
      </article>

      <!-- 4. काशी विश्वनाथ विश्वेश्वर महादेव -->
      <article class="tirtha-card">
        <div class="tirtha-img-wrap">
          <span class="tirtha-tag">तीर्थवासियों के कुलदेवता</span>
          <img src="~/assets/images/shrine-kashi-vishwanath.jpg" alt="काशी विश्वनाथ विश्वेश्वर महादेव" class="shrine-midupper" loading="lazy" />
        </div>
        <div class="tirtha-content">
          <span class="tirtha-hindi-name">4. काशी विश्वनाथ विश्वेश्वर महादेव</span>
          <h3 class="tirtha-title">नैमिष में साक्षात काशी तीर्थ व काशीकुंड</h3>
          <p class="tirtha-desc">
            नैमिषारण्य में भगवान शिव की प्रसिद्ध नगरी काशी स्वयं विराजित है। जब महर्षि दधीचि ने अस्थि दान से पूर्व सभी तीर्थों के दर्शन की इच्छा जताई, तब इंद्र के निमंत्रण पर साक्षात काशी विश्वनाथ जी यहाँ पधारे। शिवपुराण के अनुसार यहाँ धर्मराज की तपस्या से प्रसन्न होकर भगवान ने विश्वेश्वर स्वरूप में दर्शन दिया। पास ही काशीकुंड, माँ अन्नपूर्णा मंदिर व परमसंत आपानारायण स्वामी का समाधिस्थल है।
          </p>
          <div class="tirtha-meta">
            <span><i class="fa-solid fa-star"></i> बनारस तुल्य पुण्य</span>
