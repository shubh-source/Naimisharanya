<!-- ==========================================================================
     SACRED PILGRIMAGE DIRECTORY (Tirthas & Mandirs)
     ========================================================================== -->
<section class="section-padding" id="tirthas" aria-labelledby="tirthas-title">
  <div class="container">
    <div class="text-center">
      <span class="section-badge"><i class="fa-solid fa-dharmachakra"></i> Holy Pilgrimage Circuit</span>
      <h2 class="section-title" id="tirthas-title">Sacred <span>Tirthas & Ancient Temples</span></h2>
      <p class="section-subtitle">
        Every inch of Naimisharanya is sanctified with cosmic energy. Explore the paramount shrines and historical landmarks sanctified by the Gods.
      </p>
    </div>

    <div class="tirthas-grid">
      <!-- 1. Chakra Tirtha -->
      <article class="tirtha-card">
        <div class="tirtha-img-wrap">
          <span class="tirtha-tag">Center of Creation</span>
          <img src="~/wp-content/uploads/2022/07/slider1.jpg" alt="Chakra Tirtha holy circular water pond" loading="lazy" />
        </div>
        <div class="tirtha-content">
          <span class="tirtha-hindi-name">चक्र तीर्थ (Chakra Tirtha)</span>
          <h3 class="tirtha-title">The Celestial Wheel Kund</h3>
          <p class="tirtha-desc">
            When Rishis sought the holiest place for penance, Lord Brahma rolled His mind-borne Manomaya Chakra. Its rim struck here, creating this unfathomable circular pool. A holy dip (Snan) washes away lifetimes of sins.
          </p>
          <div class="tirtha-meta">
            <span><i class="fa-regular fa-clock"></i> Open: 04:00 AM - 09:30 PM</span>
            <span><i class="fa-solid fa-water"></i> Sacred Snan Ghat</span>
          </div>
        </div>
      </article>

      <!-- 2. Maa Lalita Devi Shaktipeeth -->
      <article class="tirtha-card">
        <div class="tirtha-img-wrap">
          <span class="tirtha-tag">51 Maha Shaktipeeth</span>
          <img src="~/wp-content/uploads/2022/08/event-1-1.png" alt="Maa Lalita Devi Shaktipeeth temple sanctum" loading="lazy" />
        </div>
        <div class="tirtha-content">
          <span class="tirtha-hindi-name">माँ ललिता देवी शक्तिपीठ (Maa Lalita Devi)</span>
          <h3 class="tirtha-title">Presiding Goddess of Naimish</h3>
          <p class="tirtha-desc">
            Revered as one of the supreme 51 Shaktipeeths where the sacred heart of Devi Sati manifested. The divine Akhand Jyoti burns eternally here, granting devotees courage, spiritual liberation, and family prosperity.
          </p>
          <div class="tirtha-meta">
            <span><i class="fa-regular fa-clock"></i> 05:00 AM - 10:00 PM</span>
            <span><i class="fa-solid fa-fire"></i> Chandi Paath Rituals</span>
          </div>
        </div>
      </article>

      <!-- 3. Maharishi Vyas Gaddi -->
      <article class="tirtha-card">
        <div class="tirtha-img-wrap">
          <span class="tirtha-tag">5,000+ Years Ancient</span>
          <img src="~/wp-content/uploads/2022/07/slider3.jpg" alt="Vyas Gaddi ancient sacred banyan tree" loading="lazy" />
        </div>
        <div class="tirtha-content">
          <span class="tirtha-hindi-name">व्यास गद्दी एवं वट वृक्ष (Vyas Gaddi)</span>
          <h3 class="tirtha-title">Throne of Maharishi Ved Vyas</h3>
          <p class="tirtha-desc">
            Beneath this majestic 5,000-year-old Akshaya Vat (Banyan tree), Maharishi Veda Vyas divided the single Veda into Rig, Sama, Yajur, and Atharva, and composed the 18 Maha Puranas and the Mahabharata.
          </p>
          <div class="tirtha-meta">
            <span><i class="fa-regular fa-clock"></i> 06:00 AM - 08:00 PM</span>
            <span><i class="fa-solid fa-tree"></i> Holy Banyan Tree</span>
          </div>
        </div>
      </article>

      <!-- 4. Hanuman Garhi -->
      <article class="tirtha-card">
        <div class="tirtha-img-wrap">
          <span class="tirtha-tag">Swayambhu Vigraha</span>
          <img src="~/wp-content/uploads/2022/08/event-2-1.png" alt="Hanuman Garhi South-Facing Balaji Shrine" loading="lazy" />
        </div>
        <div class="tirtha-content">
          <span class="tirtha-hindi-name">हनुमान गढ़ी (Hanuman Garhi)</span>
          <h3 class="tirtha-title">Dakshin-Mukhi Lord Hanuman</h3>
          <p class="tirtha-desc">
            A rare, south-facing self-manifested deity of Lord Hanuman carrying Lord Rama and Lakshmana on His sacred shoulders upon their glorious return from defeating Ahiravana in Patala Loka.
          </p>
          <div class="tirtha-meta">
            <span><i class="fa-regular fa-clock"></i> 05:00 AM - 09:30 PM</span>
            <span><i class="fa-solid fa-shield-heart"></i> Sankat Mochan</span>
          </div>
        </div>
      </article>

      <!-- 5. Soot Gaddi -->
      <article class="tirtha-card">
        <div class="tirtha-img-wrap">
          <span class="tirtha-tag">Purana Discourse Seat</span>
          <img src="~/wp-content/uploads/2022/08/event-3.png" alt="Soot Gaddi ancient discourse seat" loading="lazy" />
        </div>
        <div class="tirtha-content">
          <span class="tirtha-hindi-name">सूत गद्दी (Soot Gaddi)</span>
          <h3 class="tirtha-title">Puranic Assembly of 88,000 Rishis</h3>
          <p class="tirtha-desc">
            The venerated seat where disciple of Vyas, Romaharshana and Sage Sootji narrated the sacred Srimad Bhagavatam and Puranic wisdom to Kulapati Saunaka and the 88,000 rishis during their 1,000-year Mahayajna.
          </p>
          <div class="tirtha-meta">
            <span><i class="fa-regular fa-clock"></i> 06:00 AM - 07:30 PM</span>
            <span><i class="fa-solid fa-scroll"></i> Purana Pravachan</span>
          </div>
        </div>
      </article>

      <!-- 6. Maharishi Dadhichi Kund (Mishrikh) -->
      <article class="tirtha-card">
        <div class="tirtha-img-wrap">
          <span class="tirtha-tag">Supreme Sacrifice</span>
          <img src="~/wp-content/uploads/2022/07/slider2.jpg" alt="Dadhichi Kund in Mishrikh" loading="lazy" />
        </div>
        <div class="tirtha-content">
          <span class="tirtha-hindi-name">महर्षि दधीचि कुंड (Dadhichi Kund - Mishrikh)</span>
          <h3 class="tirtha-title">The Crucible of Indomitable Will</h3>
          <p class="tirtha-desc">
            Located 10 km from Chakra Tirtha, this is where Sage Dadhichi performed holy snan with water from all holy rivers and willingly donated his mortal bones to Lord Indra to forge the celestial weapon Vajra.
          </p>
          <div class="tirtha-meta">
            <span><i class="fa-regular fa-clock"></i> 05:30 AM - 08:30 PM</span>
            <span><i class="fa-solid fa-droplet"></i> Sarva Tirtha Snan</span>
          </div>
        </div>
      </article>

      <!-- 7. Dashashwamedha Ghat (Gomti River) -->
      <article class="tirtha-card">
        <div class="tirtha-img-wrap">
          <span class="tirtha-tag">Ramayana Era</span>
          <img src="~/wp-content/uploads/2023/10/pexels-navneet-scaled.jpg" alt="Dashashwamedha Ghat on sacred Gomti River" loading="lazy" />
        </div>
        <div class="tirtha-content">
          <span class="tirtha-hindi-name">दशाश्वमेध घाट - गोमती नदी</span>
          <h3 class="tirtha-title">Lord Rama's Ashwamedha Ghat</h3>
          <p class="tirtha-desc">
            The sanctified riverbank on the serene Gomti where Maryada Purushottam Lord Rama concluded His Ashwamedha Yajna under Sage Vashistha’s guidance, performing ten horse sacrifices to sanctify the realm.
          </p>
          <div class="tirtha-meta">
            <span><i class="fa-regular fa-clock"></i> Open 24 Hours</span>
            <span><i class="fa-solid fa-bridge-water"></i> Gomti Maha Aarti</span>
          </div>
        </div>
      </article>

      <!-- 8. Swayambhu Devdeveshwar Mandir & Sita Kund -->
      <article class="tirtha-card">
        <div class="tirtha-img-wrap">
          <span class="tirtha-tag">Devata Pratishtha</span>
          <img src="~/wp-content/uploads/2022/08/event-4-1.png" alt="Devdeveshwar Mandir and Sita Kund" loading="lazy" />
        </div>
        <div class="tirtha-content">
          <span class="tirtha-hindi-name">देवदेवेश्वर मंदिर एवं सीता कुंड</span>
          <h3 class="tirtha-title">Ancient Shivalinga & Mata Sita's Kund</h3>
          <p class="tirtha-desc">
            One of the oldest Shiva shrines in Awadh consecrated by the Devatas before initiating penance. Adjacent is Sita Kund, sanctified by Mata Sita during her sacred stay in the hermitages of Naimisharanya.
          </p>
          <div class="tirtha-meta">
            <span><i class="fa-regular fa-clock"></i> 05:00 AM - 09:00 PM</span>
            <span><i class="fa-solid fa-om"></i> Bilva Archana</span>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ==========================================================================
     AARTI SCHEDULE & TEMPLE TIMINGS (With Live Tracker)
     ========================================================================== -->
<section class="section-padding" id="aarti-schedule" style="background:var(--bg-alt);" aria-labelledby="aarti-heading">
  <div class="container">
    <div class="text-center">
      <span class="section-badge"><i class="fa-solid fa-clock-rotate-left"></i> Daily Temple Calendar</span>
      <h2 class="section-title" id="aarti-heading">Daily <span>Aarti & Darshan Timings</span></h2>
      <p class="section-subtitle">
        Plan your holy visit with our verified daily rituals schedule. The live status tracker automatically highlights the active or upcoming sacred ritual.
      </p>
    </div>

    <div class="aarti-schedule-wrapper">
      <div class="aarti-header-strip">
        <h3><i class="fa-solid fa-bell"></i> Naimisharanya Mandir Ritual Timings</h3>
        <div class="aarti-live-pill" id="aarti-status-pill">
          <div class="aarti-live-pulse"></div>
          <span id="aarti-status-text">Loading Live Schedule...</span>
        </div>
      </div>

      <div style="overflow-x:auto;">
        <table class="aarti-table">
          <thead>
            <tr>
              <th>Ritual / Aarti Name</th>
              <th>Timings</th>
              <th>Sacred Sanctum</th>
              <th>Devotee Participation</th>
            </tr>
          </thead>
          <tbody>
            <tr data-aarti-id="mangala">
              <td>
                <strong>मंगला आरती एवं प्रातः दर्शन</strong><br />
                <span style="font-size:0.85rem; color:var(--text-light);">Mangala Aarti & Awakening</span>
              </td>
              <td><span class="aarti-badge">05:00 AM - 05:45 AM</span></td>
              <td>Maa Lalita Devi & Devdeveshwar Mandir</td>
              <td>Allowed in outer courtyard with deepam</td>
            </tr>
            <tr data-aarti-id="snan">
              <td>
                <strong>चक्र तीर्थ स्नान एवं सूर्य तर्पण</strong><br />
                <span style="font-size:0.85rem; color:var(--text-light);">Holy Snan & Vedic Tarpan</span>
              </td>
              <td><span class="aarti-badge">06:00 AM - 11:45 AM</span></td>
              <td>Chakra Tirtha Ghats & Parikrama</td>
              <td>Open for all pilgrims with purohit sankalpa</td>
            </tr>
            <tr data-aarti-id="bhog">
              <td>
                <strong>मध्याह्न राजभोग आरती</strong><br />
                <span style="font-size:0.85rem; color:var(--text-light);">Madhyahna Rajbhog Offering</span>
              </td>
              <td><span class="aarti-badge">12:00 PM - 12:45 PM</span></td>
              <td>Main Sanctum (Garbhagriha)</td>
              <td>Devotees can offer peda & sacred prasad</td>
            </tr>
            <tr data-aarti-id="vishram">
              <td>
                <strong>मध्याह्न विश्राम (पट बंद)</strong><br />
                <span style="font-size:0.85rem; color:var(--text-light);">Afternoon Rest Period</span>
              </td>
              <td><span class="aarti-badge" style="background:#F1F5F9; color:#64748B; border-color:#CBD5E1;">01:00 PM - 04:00 PM</span></td>
              <td>Sanctum Doors Closed</td>
              <td>Kund area remains open for parikrama</td>
            </tr>
            <tr data-aarti-id="sandhya">
              <td>
                <strong>महा संध्या आरती एवं दीपदान</strong><br />
                <span style="font-size:0.85rem; color:var(--text-light);">Grand Evening Aarti & Deep Daan</span>
              </td>
              <td><span class="aarti-badge" style="background:var(--gold-light); color:var(--gold); border-color:var(--gold);">06:30 PM - 07:30 PM</span></td>
              <td>Chakra Tirtha & Gomti Ghat</td>
              <td>Grand 108-lamp aarti with public participation</td>
            </tr>
            <tr data-aarti-id="shayan">
              <td>
                <strong>शयन आरती एवं मंदिर समापन</strong><br />
                <span style="font-size:0.85rem; color:var(--text-light);">Shayan Aarti & Temple Closing</span>
              </td>
              <td><span class="aarti-badge">09:00 PM - 09:30 PM</span></td>
              <td>All Principal Shrines</td>
              <td>Final pranam and sanctum lock</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- ==========================================================================
     PRAVAS, PUJA & DARSHAN BOOKING MODULE
     ========================================================================== -->
<section class="section-padding booking-section" id="booking" aria-labelledby="booking-heading">
  <div class="container">
